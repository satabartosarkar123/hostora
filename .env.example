# Names only. Never commit real values.
# Local: copy to .env and fill in (`uv run hostora gen-keys` prints the secrets).
# Production: set these in Render (and Hugging Face Space secrets for the backup copy).

ENV=dev                                   # dev | test | prod
PUBLIC_ORIGIN=http://localhost:8000       # https://hostora.is-a.dev in production

# Database (Neon: use the DIRECT connection string, not the "-pooler" one)
DATABASE_URL=postgresql://hostora:hostora@localhost:5432/hostora
TEST_DATABASE_URL=postgresql://hostora:hostora@localhost:5432/hostora_test

# Secrets (generate with: uv run hostora gen-keys)
SECRET_KEY=                               # session cookie signing
TOKEN_HMAC_SECRET=                        # invite link tokens, gate tokens, IP hashing
PHONE_ENC_KEY=                            # base64 of 32 random bytes (AES-GCM)
PASS_SIGNING_KEY=                         # Ed25519 private key, hex
PASS_PUBLIC_KEY=                          # Ed25519 public key, hex (not secret)
CRON_SECRET=                              # signs /internal/cron calls from GitHub Actions

# Firebase Authentication (web config values are public; the project id is used to verify tokens)
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=

# LLMs (all optional: without keys the planner uses the deterministic template)
GROQ_API_KEY=
GROQ_MODEL_LARGE=openai/gpt-oss-120b      # verify current model ids at build time
GROQ_MODEL_SMALL=llama-3.1-8b-instant
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash             # verify current model id at build time
GEMINI_ALLOWED=false                      # free tier may train on inputs; only redacted text is ever sent

# Demo
DEMO_MODE=false                           # true enables "Try demo" login and /v1/demo/seed

# Optional
SENTRY_DSN=
LOG_LEVEL=INFO

# GitHub Actions only (repository secrets, not app env)
# APP_URL (variable), CRON_SECRET, BACKUP_PASSPHRASE, HF_TOKEN (optional)
